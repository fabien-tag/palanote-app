  AUTH_USERS { uuid id PK
    text email }
  PROFILES { uuid id PK "FK auth.users"
    text prenom
    text niveau
    bool partage_photos }
  DIVES { uuid id PK
    uuid user_id FK
    uuid sortie_id FK
    date dive_date
    text site_name
    numeric max_depth_m
    int duration_min
    text dive_type
    bool stamped }
  MEDIA { uuid id PK
    uuid user_id FK
    uuid dive_id FK
    text chemin
    bool partagee }
  DIVE_SPECIES { uuid id PK
    uuid dive_id FK
    uuid media_id FK
    text nom
    numeric confiance
    text statut }
  DIVE_BUDDIES { uuid id PK
    uuid dive_id FK
    uuid buddy_user_id FK
    uuid copie_dive_id FK
    text statut }
  FRIENDSHIPS { uuid id PK
    uuid user_a FK
    uuid user_b FK
    friend_status statut }
  OCR_BATCHES { uuid id PK
    uuid user_id FK
    int nb_pages
    ocr_batch_status statut }
  OCR_PAGES { uuid id PK
    uuid batch_id FK
    uuid media_id FK
    ocr_page_status statut
    text modele }
  OCR_EXTRACTIONS { uuid id PK
    uuid page_id FK
    uuid dive_id FK
    jsonb champs
    jsonb confiances }
  NOTIFICATIONS { uuid id PK
    uuid user_id FK
    text type
    timestamptz lue_le }
  PLONGEUR_BREVETS { uuid id PK
    uuid user_id FK
    text intitule
    uuid verifie_par FK }
